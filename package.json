{
  "name": "git-repo-and-branch-explorer",
  "displayName": "Git Repo & Branch Explorer",
  "description": "Visual Studio-style Git Repository explorer: branch/remote/tag tree in the Activity Bar, multi-lane SVG commit graph and history timeline in the editor, file diff inspection, and GitHub/Git Graph integration.",
  "version": "1.9.0",
  "publisher": "juddersoft",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/juddersoft/GitRepoAndBranchExplorer.git"
  },
  "bugs": {
    "url": "https://github.com/juddersoft/GitRepoAndBranchExplorer/issues"
  },
  "homepage": "https://github.com/juddersoft/GitRepoAndBranchExplorer#readme",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "git",
    "repository",
    "branch",
    "graph",
    "history",
    "visual studio",
    "github",
    "git blame",
    "annotate",
    "gitlens alternative"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Executing Git commands in untrusted repositories is disabled to prevent arbitrary code execution via malicious repository configuration."
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitRepoAndBranchExplorer-container",
          "title": "Git Repo & Branch Explorer",
          "icon": "media/git-repo-icon.svg"
        }
      ]
    },
    "views": {
      "gitRepoAndBranchExplorer-container": [
        {
          "id": "gitRepoAndBranchExplorer.launcher",
          "name": "Git Repo & Branch Explorer",
          "type": "webview",
          "icon": "media/git-repo-icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "gitRepoAndBranchExplorer.openRepository",
        "title": "Git Repo & Branch Explorer: Open Repository Window",
        "icon": "$(git-branch)"
      },
      {
        "command": "gitRepoAndBranchExplorer.refresh",
        "title": "Git Repo & Branch Explorer: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "gitRepoAndBranchExplorer.cloneRepository",
        "title": "Git Repo & Branch Explorer: Clone Repository…"
      },
      {
        "command": "gitRepoAndBranchExplorer.stashFile",
        "title": "Git Repo & Branch Explorer: Stash File…"
      },
      {
        "command": "gitRepoAndBranchExplorer.viewFileHistory",
        "title": "Git Repo & Branch Explorer: View File History",
        "icon": "$(history)"
      },
      {
        "command": "gitRepoAndBranchExplorer.viewLineHistory",
        "title": "Git Repo & Branch Explorer: View Line History"
      },
      {
        "command": "gitRepoAndBranchExplorer.compareWithPreviousRevision",
        "title": "Git Repo & Branch Explorer: Compare File with Previous Revision",
        "icon": "$(diff)"
      },
      {
        "command": "gitRepoAndBranchExplorer.openPreviousRevision",
        "title": "Git Repo & Branch Explorer: Open Previous File Revision"
      },
      {
        "command": "gitRepoAndBranchExplorer.toggleInlineBlame",
        "title": "Git Repo & Branch Explorer: Toggle Inline Git Blame",
        "icon": "$(git-commit)"
      },
      {
        "command": "gitRepoAndBranchExplorer.toggleFileAnnotate",
        "title": "Git Repo & Branch Explorer: Toggle File Blame Gutter (Annotate)",
        "icon": "$(list-flat)"
      },
      {
        "command": "gitRepoAndBranchExplorer.applyPatch",
        "title": "Git Repo & Branch Explorer: Apply Patch…"
      },
      {
        "command": "gitRepoAndBranchExplorer.copyRemoteFileUrl",
        "title": "Git Repo & Branch Explorer: Copy Remote File/Line URL"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "gitRepoAndBranchExplorer.toggleFileAnnotate",
          "when": "resourceScheme == file",
          "group": "gitRepoAndBranchExplorer@1"
        },
        {
          "command": "gitRepoAndBranchExplorer.stashFile",
          "when": "resourceScheme == file",
          "group": "gitRepoAndBranchExplorer@2"
        },
        {
          "command": "gitRepoAndBranchExplorer.viewFileHistory",
          "when": "resourceScheme == file",
          "group": "gitRepoAndBranchExplorer@3"
        },
        {
          "command": "gitRepoAndBranchExplorer.viewLineHistory",
          "when": "resourceScheme == file && editorHasSelection",
          "group": "gitRepoAndBranchExplorer@4"
        },
        {
          "command": "gitRepoAndBranchExplorer.compareWithPreviousRevision",
          "when": "resourceScheme == file",
          "group": "gitRepoAndBranchExplorer@5"
        },
        {
          "command": "gitRepoAndBranchExplorer.copyRemoteFileUrl",
          "when": "resourceScheme == file",
          "group": "gitRepoAndBranchExplorer@6"
        }
      ],
      "explorer/context": [
        {
          "command": "gitRepoAndBranchExplorer.stashFile",
          "when": "resourceScheme == file && !explorerResourceIsFolder",
          "group": "gitRepoAndBranchExplorer@1"
        },
        {
          "command": "gitRepoAndBranchExplorer.viewFileHistory",
          "when": "resourceScheme == file && !explorerResourceIsFolder",
          "group": "gitRepoAndBranchExplorer@2"
        },
        {
          "command": "gitRepoAndBranchExplorer.compareWithPreviousRevision",
          "when": "resourceScheme == file && !explorerResourceIsFolder",
          "group": "gitRepoAndBranchExplorer@3"
        },
        {
          "command": "gitRepoAndBranchExplorer.copyRemoteFileUrl",
          "when": "resourceScheme == file && !explorerResourceIsFolder",
          "group": "gitRepoAndBranchExplorer@4"
        }
      ],
      "editor/title": [
        {
          "command": "gitRepoAndBranchExplorer.viewFileHistory",
          "when": "resourceScheme == file",
          "group": "navigation@90"
        },
        {
          "command": "gitRepoAndBranchExplorer.compareWithPreviousRevision",
          "when": "resourceScheme == file",
          "group": "navigation@91"
        }
      ]
    },
    "configuration": {
      "title": "Git Repo & Branch Explorer",
      "properties": {
        "gitRepoAndBranchExplorer.workspaceRoot": {
          "type": "string",
          "default": "",
          "description": "Optional parent folder path scanned shallowly (up to 2 levels deep) to discover additional Git repositories under Repos:."
        },
        "gitRepoAndBranchExplorer.blame.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show subtle inline Git blame annotation on the active editor line."
        },
        "gitRepoAndBranchExplorer.blame.ignoreWhitespace": {
          "type": "boolean",
          "default": false,
          "description": "Ignore whitespace changes when running git blame (-w)."
        },
        "gitRepoAndBranchExplorer.blame.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show active-line Git blame summary in the status bar."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "compile:integration": "tsc -p tsconfig.integration.json",
    "pretest:integration": "npm run compile && npm run compile:integration",
    "test:integration": "vscode-test",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.95.0",
    "@vitest/coverage-v8": "^2.1.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}

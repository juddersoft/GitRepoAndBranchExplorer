{
  "name": "git-repo-and-branch-explorer",
  "displayName": "Git Repo & Branch Explorer",
  "description": "Visual Studio-style Git Repository explorer: branch/remote/tag tree in the Activity Bar, multi-lane SVG commit graph and history timeline in the editor, file diff inspection, and GitHub/Git Graph integration.",
  "version": "1.4.0",
  "publisher": "PeterJudd",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/PeterJudd/GitRepoAndBranchExplorer.git"
  },
  "bugs": {
    "url": "https://github.com/PeterJudd/GitRepoAndBranchExplorer/issues"
  },
  "homepage": "https://github.com/PeterJudd/GitRepoAndBranchExplorer#readme",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "git",
    "repository",
    "branch",
    "graph",
    "history",
    "visual studio",
    "github"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Executing Git commands in untrusted repositories is disabled to prevent arbitrary code execution via malicious repository configuration."
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitRepoAndBranchExplorer-container",
          "title": "Git Repo & Branch Explorer",
          "icon": "media/git-repo-icon.svg"
        }
      ]
    },
    "views": {
      "gitRepoAndBranchExplorer-container": [
        {
          "id": "gitRepoAndBranchExplorer.launcher",
          "name": "Git Repo & Branch Explorer",
          "type": "webview",
          "icon": "media/git-repo-icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "gitRepoAndBranchExplorer.openRepository",
        "title": "Git Repo & Branch Explorer: Open Repository Window",
        "icon": "$(git-branch)"
      },
      {
        "command": "gitRepoAndBranchExplorer.refresh",
        "title": "Git Repo & Branch Explorer: Refresh",
        "icon": "$(refresh)"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "compile:integration": "tsc -p tsconfig.integration.json",
    "pretest:integration": "npm run compile && npm run compile:integration",
    "test:integration": "vscode-test",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.95.0",
    "@vitest/coverage-v8": "^2.1.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}

# Sources, tests and build tooling (the extension ships the esbuild bundles in dist/)
src/**
tests/**
out-test/**
coverage/**
docs/**
node_modules/**
.vscode/**
.vscode-test/**
.vscode-test.mjs
.gitignore
.stignore
tsconfig.json
tsconfig.integration.json
vitest.config.ts
esbuild.js
**/*.ts
**/*.map
**/*.vsix
# Screenshots are Marketplace/Open VSX README links (raw GitHub URLs), not extension assets.
media/screenshots/*.png

# The webview stylesheet is loaded at runtime from src/webview/ui (see webviewResources.ts localResourceRoots).
!src/webview/ui/styles.css
